# 本地净化工具链，不发布
*.pyc
.workbuddy/
__pycache__/

# 运行日志与 IDE 配置：含本机路径 / 账号 GUID，属中间产物，不入库
破甲日志.txt
*.log
.idea/
_qq/
历史备份/
.workbuddy-ai/

# 根目录的临时脚本与快照：只忽略仓库根这一层，不误伤子目录里的同名文件
# （src/pojia.py 曾被裸规则 pojia.py 吃掉，导致实现文件进不了版本控制）
/_ad_poster.html
/c1.json
/c2.json
/clean.py
/commits.json
/decrypt_seal.py
/diag.py
/pojia.py
/_trace.py
/_repl.py
/_repl2.py
/_repl3.py
/_bulk.py
/_new.py
/_new2.py
/_pcmp*.py
/_rescale.py
/_export.py
/_tavern*
/_rename_*.py
/_rebrand*.py
/_patch_*.py
/_restore_check.py
/_cmt*.py
/_strip_cmt.py
/.spec-src/

# 运行期状态（补丁清单，含本机绝对路径，不入库）
state/
backups/
# 工作日志（.workbuddy-ai 的镜像），不进仓库
memory/

# 测试产物
.pytest_cache/

# 打包产物（PyInstaller）
build/
dist/
*.spec

# 签名私钥与证书：绝不入库。*.pfx/*.pvk 是私钥，泄漏等于任何人都能冒充发布者。
*.pfx
*.pvk
*.spc
*.p12
*.cer

# 例外：**公钥**证书要入库 —— 它是验签的锚点。没有它，用户验签时还是得回头
# 信任发布页，签名就真只剩装逼了。私钥（.pfx / .pvk）仍然挡在上面。
!tools/codesign/*.cer

# set-signing-secrets.ps1 在没装 gh 时会把 pfx 的 base64 落在这里，等用户手动
# 粘进 GitHub。这就是私钥本身，一个字都不能进仓库。
.signing-secrets.local/

# temp snapshots
*.bak
*.bak-*

# GitHub API 临时响应：查 Release / CI 时 curl 落的隐藏点文件，属中间产物
.r*.json
.p*.json

# pytest --basetemp 产物
/.pt*/

# 打包产物（setup.exe 等），由 tools/build_installer.py 生成
/out/
